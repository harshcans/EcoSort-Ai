{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api/index"
    }
  ],
  "functions": {
    "api/index.py": {
      "maxDuration": 60,
      "includeFiles": "artifact/**",
      "excludeFiles": "{env/**,.venv/**,Data/**,notebook/**,src/**,.git/**,**/__pycache__/**}"
    }
  }
}
